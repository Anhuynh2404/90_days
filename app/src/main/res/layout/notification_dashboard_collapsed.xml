<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_collapsed_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="0dp"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp">

    <!-- Header Row: Full Width -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_collapsed_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PROJECT 90 • NGÀY 12/90"
            android:textColor="#48BB78"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_collapsed_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 7N"
            android:textColor="#FFB800"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_notif_streak"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <!-- Subtitle and Progress Row: Full Width -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical">

        <ProgressBar
            android:id="@+id/notif_collapsed_progressbar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="65"
            android:progressDrawable="@drawable/notif_progressbar" />

        <TextView
            android:id="@+id/notif_collapsed_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="8/13 Đạt"
            android:textColor="#68D391"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Status message: Full Width -->
    <TextView
        android:id="@+id/notif_collapsed_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="⚠️ Còn 5 mục chưa xong hôm nay (Vuốt xuống để xem chi tiết)"
        android:textColor="#C6D8CB"
        android:textSize="10.5sp"
        android:singleLine="true" />

</LinearLayout>
